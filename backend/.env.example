# Copy this file to .env for local development
# On Render, set these in the Environment Variables dashboard

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/localsale?retryWrites=true&w=majority

# Port (Render sets this automatically — leave as 5000 for local)
PORT=5000
